# ---------------------------------------------------------------------------
# ActionLoop configuration
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
# `.env` is git-ignored. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./actionloop.db

# --- Claude / Anthropic ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Set this to a model id that your account can access.
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TIMEOUT_SECONDS=60

# --- Google OAuth 2.0 ---
# https://console.cloud.google.com/apis/credentials  ->  OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Where the OAuth refresh/access token is cached locally.
# The parent directory is git-ignored (see .gitignore -> .secrets/).
GOOGLE_TOKEN_PATH=.secrets/google_token.json

# --- Google Calendar ---
# "primary" means the authenticated user's default calendar.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=UTC
CALENDAR_EVENT_DURATION_MINUTES=30

# --- Gmail ---
# Optional. If empty, the follow-up draft is addressed to the authenticated
# user (a self-note). ActionLoop only ever creates DRAFTS -- it never sends.
GMAIL_FOLLOW_UP_RECIPIENT=

# --- Guardrails ---
MAX_TRANSCRIPT_CHARS=40000
MAX_EXTRACTED_ITEMS=50